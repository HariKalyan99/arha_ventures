# Client — enquiry / lead-magnet POST targets (defaults shown)
# VITE_INQUIRY_ENDPOINT=/api/inquiry
# VITE_LEAD_MAGNET_ENDPOINT=/api/lead-magnet

# Server (Vercel → Project Settings → Environment Variables)
# Never prefix these with VITE_ — they must stay server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional CORS extras (comma-separated).
# Localhost, same-origin requests, VERCEL_URL, VERCEL_BRANCH_URL, and
# VERCEL_PROJECT_PRODUCTION_URL are already allowed automatically.
# PUBLIC_BASE_URL=https://arha.example.com
# ALLOWED_ORIGINS=https://arha.example.com,https://www.arha.example.com
