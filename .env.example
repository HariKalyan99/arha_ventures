# Client — enquiry / lead-magnet POST targets (defaults shown)
# VITE_INQUIRY_ENDPOINT=/api/inquiry
# VITE_LEAD_MAGNET_ENDPOINT=/api/lead-magnet

# Server (Vercel → Project Settings → Environment Variables)
# Never prefix these with VITE_ — they must stay server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional CORS — only needed for custom / multi-domain setups.
# Same-origin posts (site host === API host) are always allowed.
# Vercel also injects VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_BASE_URL=https://arha-ventures.vercel.app
ALLOWED_ORIGINS=https://arha-ventures.vercel.app
# When you move to a custom domain, update both, e.g.:
# PUBLIC_BASE_URL=https://arha.com
# ALLOWED_ORIGINS=https://arha.com,https://www.arha.com
